# --- Servidor ---
PORT=3000
# 1 = dados fixos, sem chamar serviços externos. 0 = serviços reais.
MOCK=1
# URL do site (sem barra no final). Várias: separe por vírgula.
CORS_ORIGIN=http://localhost:5173
# URL pública do backend (links de compartilhamento). Sem ela, usa o host da requisição.
PUBLIC_URL=
# Atrás do proxy da hospedagem (IP real e https). TRUST_PROXY=0 desliga.
TRUST_PROXY=1
# Render Free: URL do próprio /health para pingar a cada 10 min e o serviço não dormir. Vazio = desligado.
KEEP_ALIVE_URL=

# --- OpenAI (voz, Decisions API e extração do portal usam a mesma chave) ---
OPENAI_API_KEY=
# Voz do site (OpenAI Realtime): o mais barato com function calling. Exige conta paga (tier Build+).
# Ainda não validado com chave real; se /voice/token der 502, confira o acesso ao modelo na conta.
VOICE_MODEL=gpt-realtime-2.1-mini
# Próximo passo sugerido (Decisions API). DECISIONS=0 desliga e usa só regras fixas.
DECISIONS=1
DECISIONS_MODEL=gpt-6-luna
# Extração de dados das páginas do portal (GPT-6 Astra, modelo dos dots). gpt-6.1-sol é mais barato.
EXTRACTION_MODEL=gpt-6-astra

# --- dots (servidor MCP em /mcp). Sem chave, fica desligado ---
MCP_API_KEY=

# --- Login gov.br e Portal Senatran (Browserbase) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Proxy residencial (país) para o captcha do gov.br aceitar o acesso. "off" desliga.
BROWSERBASE_PROXY=BR
PORTAL_URL=https://portalservicos.senatran.serpro.gov.br/
# Rotas do catálogo oficial do portal. Já têm padrão no código; só preencha para sobrescrever.
# PORTAL_LOGIN_URL é uma tela protegida: abri-la força o login no gov.br (a home é pública).
PORTAL_LOGIN_URL=https://portalservicos.senatran.serpro.gov.br/#/infracoes/consultar
SENATRAN_CNH_URL=https://portalservicos.senatran.serpro.gov.br/#/habilitacao/consultar
SENATRAN_MULTAS_URL=https://portalservicos.senatran.serpro.gov.br/#/infracoes/consultar
SENATRAN_VEICULOS_URL=https://portalservicos.senatran.serpro.gov.br/#/veiculos/meus-veiculos

# --- Infosimples (só consultas que NÃO pedem senha gov.br) ---
# O token liga: recall dos veículos (senatran/recall) e prazo do exame toxicológico (senatran/exame-toxicologico).
INFOSIMPLES_TOKEN=
# Opcionais: multas/veículo sem login para um estado específico. Deixe vazio (o portal com login cobre isso).
INFOSIMPLES_MULTAS_URL=
INFOSIMPLES_VEICULO_URL=

ADAPTER_TIMEOUT_MS=15000

# --- Guia de pagamento (boleto/Pix oficial do SNE, gerada no próprio portal com o login gov.br) ---
# GUIA_DEMO=1 devolve uma guia de DEMONSTRAÇÃO (marcada, não pagável) enquanto a tela de pagamento
# do portal não for validada com login real. Deixe 0 para usar o portal.
GUIA_DEMO=0
