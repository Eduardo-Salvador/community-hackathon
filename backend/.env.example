PORT=3000
MOCK=1
CORS_ORIGIN=http://localhost:5173
# URL pública do backend (links de compartilhamento). Sem ela, usa o host da requisição.
PUBLIC_URL=
# Atrás do proxy da Railway (IP real e https). TRUST_PROXY=0 desliga.
TRUST_PROXY=1
# Render Free: URL do próprio /health para pingar a cada 10 min e o serviço não dormir. Vazio = desligado.
KEEP_ALIVE_URL=
# Servidor MCP em /mcp (para o dots). Sem chave, fica desligado.
MCP_API_KEY=

# Voz (OpenAI Realtime). Confirmar o nome do modelo.
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime
# Extração de dados do portal (GPT-6 Astra, modelo dos dots). gpt-6.1-sol é mais barato.
EXTRACTION_MODEL=gpt-6-astra

# OpenAI Decisions API (próximo passo). Usa a OPENAI_API_KEY; DECISIONS=0 desliga e usa só regras fixas.
DECISIONS=1
DECISIONS_MODEL=gpt-6-luna
INFOSIMPLES_TOKEN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PORTAL_URL=https://portalservicos.senatran.serpro.gov.br/
