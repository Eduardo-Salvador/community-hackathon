# --- Servidor ---
PORT=3000
# 1 = dados fixos, sem chamar serviços externos. 0 = serviços reais.
MOCK=1
CORS_ORIGIN=http://localhost:5173
# URL pública do backend (links de compartilhamento). Sem ela, usa o host da requisição.
PUBLIC_URL=
# Atrás do proxy da hospedagem (IP real e https). TRUST_PROXY=0 desliga.
TRUST_PROXY=1
# Render Free: URL do próprio /health para pingar a cada 10 min e o serviço não dormir. Vazio = desligado.
KEEP_ALIVE_URL=

# --- OpenAI (voz, Decisions API e extração do portal usam a mesma chave) ---
OPENAI_API_KEY=
# Voz do site (OpenAI Realtime). Confirmar o nome do modelo.
VOICE_MODEL=gpt-realtime
# Próximo passo sugerido (Decisions API). DECISIONS=0 desliga e usa só regras fixas.
DECISIONS=1
DECISIONS_MODEL=gpt-6-luna
# Extração de dados das páginas do portal (GPT-6 Astra, modelo dos dots). gpt-6.1-sol é mais barato.
EXTRACTION_MODEL=gpt-6-astra

# --- dots (servidor MCP em /mcp). Sem chave, fica desligado ---
MCP_API_KEY=

# --- Login gov.br e Portal Senatran (Browserbase) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PORTAL_URL=https://portalservicos.senatran.serpro.gov.br/
# Telas autenticadas de infrações e veículos no Portal de Serviços da Senatran.
SENATRAN_MULTAS_URL=
SENATRAN_VEICULOS_URL=

# --- Infosimples (consultas de multas e veículo, fallback sem login) ---
INFOSIMPLES_TOKEN=
# Cada UF/produto da Infosimples possui uma URL de consulta própria.
INFOSIMPLES_MULTAS_URL=
INFOSIMPLES_VEICULO_URL=

# --- Zapay (guia, boleto e Pix) ---
ZAPAY_GUIA_URL=
ZAPAY_ACCESS_TOKEN=
ZAPAY_CUSTOMER_ID=
ZAPAY_AUTH_SCHEME=JWT
ZAPAY_API_VERSION=v2.0
ADAPTER_TIMEOUT_MS=15000
