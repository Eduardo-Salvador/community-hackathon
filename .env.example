PORT=3000
MOCK=1
CORS_ORIGIN=http://localhost:5173

# Voz (OpenAI Realtime). Confirmar o nome do modelo.
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime

XAI_API_KEY=
JEV_API_KEY=
INFOSIMPLES_TOKEN=
# Cada UF/produto da Infosimples possui uma URL de consulta própria.
INFOSIMPLES_MULTAS_URL=
INFOSIMPLES_VEICULO_URL=

# URL confirmada da tela de infrações no Portal de Serviços da Senatran.
SENATRAN_MULTAS_URL=

# Token temporário obtido com as credenciais de parceiro da Zapay.
ZAPAY_GUIA_URL=
ZAPAY_ACCESS_TOKEN=
ZAPAY_AUTH_SCHEME=JWT
ZAPAY_API_VERSION=v2.0

ADAPTER_TIMEOUT_MS=15000
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
